# AI Provider (openai | openrouter, default: openai)
# Set to openrouter to route transcription and chat generation
# through OpenRouter instead of the OpenAI API directly
# AI_PROVIDER=openai

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# OpenAI model overrides (optional, defaults shown)
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# OPENAI_CHAT_MODEL=gpt-4o

# OpenRouter API Configuration (required when AI_PROVIDER=openrouter)
# OpenRouter exposes many models through one OpenAI-compatible API
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=WhatsApp Transcription Bot
# OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
# OPENROUTER_CHAT_MODEL=openai/gpt-4o

# Authorized WhatsApp Numbers (comma-separated)
# Format: +1234567890,+0987654321
# These are the phone numbers that can use commands
AUTHORIZED_NUMBERS=+1234567890,+0987654321

# Bot Language (en or de)
# Controls the language of bot messages and responses
BOT_LANGUAGE=en

# Transcription output language (optional)
# Forces transcription output to a specific ISO-639-1 language
# (e.g. en, de, fr, it, es). If unset, the language is auto-detected.
# TRANSCRIPTION_LANGUAGE=en

# WhatsApp Web Version (optional)
# Pin to a specific WhatsApp Web version for stability
# Example: 2.3000.1029960097-alpha
# If not set, uses the latest version automatically
# You can find the list of versions in the recent releases here: https://github.com/wppconnect-team/wa-version/releases
# WEB_VERSION=2.3000.1029960097-alpha

# Timezone (optional, IANA timezone identifier)
# Used for scheduling birthday wishes and reminders
# If not set, uses the system timezone
# Examples: Europe/Zurich, Europe/Berlin, America/New_York, Asia/Tokyo
# BOT_TIMEZONE=Europe/Zurich

# Profile Cinema (optional)
# Provide a movie file to rotate the profile photo frame-by-frame
# PROFILE_MOVIE_PATH=./data/profile.mp4
# PROFILE_MESSAGE_INTERVAL=25
# PROFILE_FRAME_MAX_KB=100

# Debug Mode (optional)
# Enable logging for all WhatsApp events (default: false)
# Useful for debugging and understanding event flow
# DEBUG=true

# Logging (optional)
# By default every record is one line in Swiss local time (Europe/Zurich):
#   2026-10-24 08:50:21 INFO     Startup: Timezone configured timezone=Europe/Zurich source=auto-detected
# LOG_FORMAT=json writes one JSON object per line instead.
# LOG_LEVEL=info  # debug, info, warn or error
# LOG_FORMAT=json
